# Email is sent in the browser with EmailJS.
# Keys and template IDs live in lib/emailjs.ts. No SMTP or webhook secrets are required.
#
# Microsoft Clarity (Settings > Overview in your Clarity project):
# NEXT_PUBLIC_CLARITY_PROJECT_ID=yourProjectId
#
# Free Sample Video uses the existing Google Apps Script webhook
# (same spreadsheet as visitor tracking). Override only if you deploy a new script:
# NEXT_PUBLIC_GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
#
# Add the verified public Clutch profile URL when the profile is live. It will
# then be included in Organization structured data.
# NEXT_PUBLIC_CLUTCH_URL=https://clutch.co/profile/your-verified-profile
