# Email is sent in the browser with EmailJS.
# Keys and template IDs live in lib/emailjs.ts. No SMTP or webhook secrets are required.
#
# Free Website Audit uses the existing Google Apps Script webhook
# (same spreadsheet as visitor tracking). Override only if you deploy a new script:
# NEXT_PUBLIC_GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
